<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-ecosystems-plugins</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-ecosystem-maven</artifactId>
    <name>Porelo Ecosystem Maven</name>
    <description>Recognizes what a Maven checkout needs</description>
    <properties>
        <maven-model-builder.version>3.10.0</maven-model-builder.version>
        <porelo-ecosystem-api.version>0.5.1-SNAPSHOT</porelo-ecosystem-api.version>
        <jdeb.version>1.14</jdeb.version>
        <!-- The build's run number: a snapshot's package is <version>~snapshot.<run>, below its release and above the
             run before, or apt and dnf would never offer a newer build. -->
        <package.snapshot.run>0</package.snapshot.run>
        <!-- What the executable links, read with readelf, which both packages declare by hand: neither plugin reads a
             binary. check-linkage holds the executable to them. -->
        <package.glibc.floor>2.34</package.glibc.floor>
        <package.glibc.ceiling>2.41</package.glibc.ceiling>
        <package.zlib.floor>1.2.2</package.zlib.floor>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-ecosystem-api</artifactId>
            <version>${porelo-ecosystem-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model-builder</artifactId>
            <version>${maven-model-builder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Real Maven answers the comparison test, from the wrapper this build pins. -->
                        <test.maven.wrapper>${maven.multiModuleProjectDirectory}/mvnw</test.maven.wrapper>
                        <test.maven.repository>${settings.localRepository}</test.maven.repository>
                        <test.maven.help.version>${maven-help-plugin.version}</test.maven.help.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The executable and its package; a push builds without it, as an image takes minutes. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-porelo-ecosystem-maven</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>${project.artifactId}</imageName>
                                    <!-- What the image holds is this module's own list, tested against the jar. -->
                                    <metadataRepository>
                                        <enabled>false</enabled>
                                    </metadataRepository>
                                    <mainClass>org.fuin.porelo.ecosystem.maven.MavenEcosystem</mainClass>
                                    <buildArgs>
                                        <buildArg>-march=x86-64</buildArg>
                                        <buildArg>--no-fallback</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <test.native.executable>${project.build.directory}/${project.artifactId}</test.native.executable>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-version</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>regex-property</goal>
                                </goals>
                                <configuration>
                                    <name>package.version</name>
                                    <value>${project.version}</value>
                                    <regex>-SNAPSHOT$</regex>
                                    <replacement>~snapshot.${package.snapshot.run}</replacement>
                                    <failIfNoMatch>false</failIfNoMatch>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <version>${jdeb.version}</version>
                        <executions>
                            <execution>
                                <id>deb</id>
                                <!-- Not package: the image binds there and a parent's plugin runs first. -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <deb>${project.build.directory}/${project.artifactId}_${package.version}_amd64.deb</deb>
                                    <controlDir>${project.basedir}/src/deb/control</controlDir>
                                    <dataSet>
                                        <data>
                                            <src>${project.build.directory}/${project.artifactId}</src>
                                            <dst>maven</dst>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/libexec/porelo/ecosystems</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- Debian Policy 12.5: every binary package ships one. -->
                                        <data>
                                            <src>${project.basedir}/src/deb/copyright/copyright</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/${project.artifactId}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>de.dentrassi.maven</groupId>
                        <artifactId>rpm</artifactId>
                        <version>${dentrassi-rpm.version}</version>
                        <executions>
                            <execution>
                                <id>rpm</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>rpm</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <packageName>${project.artifactId}</packageName>
                            <version>${package.version}</version>
                            <snapshotVersion>${package.version}</snapshotVersion>
                            <release>1</release>
                            <!-- Without this a snapshot gets a timestamp release, and the rpm and the deb disagree. -->
                            <forceRelease>true</forceRelease>
                            <summary>Recognizes what a Maven checkout needs, for Porelo</summary>
                            <description>Installs one program under /usr/libexec/porelo/ecosystems, where the porelo binary finds its build-tool plugins. It reads a checkout's poms and the person's Maven settings, runs no project code and opens no connection.</description>
                            <architecture>x86_64</architecture>
                            <group>Applications/System</group>
                            <license>GPL-3.0-or-later AND Apache-2.0</license>
                            <packager>Michael Schnell &lt;michael@fuin.org&gt;</packager>
                            <requires>
                                <require>porelo</require>
                                <!-- The names rpmbuild itself generates for these libraries. -->
                                <require>libc.so.6(GLIBC_${package.glibc.floor})(64bit)</require>
                                <require>libz.so.1(ZLIB_${package.zlib.floor})(64bit)</require>
                            </requires>
                            <signature>
                                <skip>true</skip>
                            </signature>
                            <entries>
                                <entry>
                                    <name>/usr/libexec/porelo/ecosystems/maven</name>
                                    <file>${project.build.directory}/${project.artifactId}</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- 'license' marks it %license, so 'rpm -qL' answers. -->
                                <entry>
                                    <name>/usr/share/licenses/${project.artifactId}/LICENSE</name>
                                    <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                    <license>true</license>
                                </entry>
                                <entry>
                                    <name>/usr/share/licenses/${project.artifactId}/LICENSE.Apache-2.0</name>
                                    <file>${maven.multiModuleProjectDirectory}/LICENSE-Apache-2.0</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                    <license>true</license>
                                </entry>
                            </entries>
                        </configuration>
                    </plugin>
                    <!-- After both packages, as all bind to verify and run in this order: the executable against what
                         the packages declare, then what the packages say their version is. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-linkage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-linkage --declare libc.so.6=GLIBC:${package.glibc.floor} --declare libz.so.1=ZLIB:${package.zlib.floor} --ceiling GLIBC=${package.glibc.ceiling} ${project.build.directory}/${project.artifactId}</commandlineArgs>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-package-version</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-package-version ${project.artifactId} ${project.version} ${package.snapshot.run} ${project.build.directory}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
