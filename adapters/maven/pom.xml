<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-ecosystems-adapters</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-ecosystem-maven</artifactId>
    <name>Porelo Ecosystem Maven</name>
    <description>Recognizes what a Maven checkout needs</description>
    <properties>
        <maven-model-builder.version>3.10.0</maven-model-builder.version>
        <adapter.name>maven</adapter.name>
        <adapter.packages.skip>false</adapter.packages.skip>
        <adapter.mainClass>org.fuin.porelo.ecosystem.maven.MavenEcosystem</adapter.mainClass>
        <adapter.summary>Recognizes what a Maven checkout needs, for Porelo</adapter.summary>
        <adapter.description>Installs one program under /usr/libexec/porelo/ecosystems, where the porelo binary finds its ecosystem adapters. It reads a checkout's poms and the person's Maven settings, runs no project code and opens no connection.</adapter.description>
        <adapter.license>GPL-3.0-or-later AND Apache-2.0 AND EPL-2.0 AND BSD-3-Clause AND MIT AND BSD-2-Clause AND xpp AND GPL-2.0-only WITH Classpath-exception-2.0</adapter.license>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-ecosystem-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-ecosystem-api</artifactId>
            <version>${porelo-ecosystem-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model-builder</artifactId>
            <version>${maven-model-builder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Only what must carry a build value is filtered, so nothing else loses a ${...} it means literally. -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Bounded: unbounded, the fork takes a quarter of the machine's memory for the models it builds. -->
                    <argLine>-Xmx1g</argLine>
                    <systemPropertyVariables>
                        <!-- Real Maven answers the comparison test, from the wrapper this build pins. -->
                        <test.maven.wrapper>${maven.multiModuleProjectDirectory}/mvnw</test.maven.wrapper>
                        <test.maven.repository>${settings.localRepository}</test.maven.repository>
                        <test.maven.help.version>${maven-help-plugin.version}</test.maven.help.version>
                        <test.package.version>${package.version}</test.package.version>
                        <test.runtime.classpath>${project.build.directory}/classpath.txt</test.runtime.classpath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The executable and its packages, as the parent manages them; in this order, since what binds to verify runs
             as named here. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>de.dentrassi.maven</groupId>
                        <artifactId>rpm</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
